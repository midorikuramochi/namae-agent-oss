# AI Studio mode: set an API key and leave GOOGLE_CLOUD_PROJECT unset.
GEMINI_API_KEY=

# Vertex AI mode: authenticate with Application Default Credentials and set these.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: override the gcloud binary path used to obtain an ADC access token.
# GCLOUD_BIN=/path/to/gcloud
